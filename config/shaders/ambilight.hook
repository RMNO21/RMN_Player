//!HOOK MAIN
//!BIND HOOKED
//!SAVE AMBIENT_BLUR1
//!DESC Ambilight Horizontal 2D Diffusion Pass
//!WIDTH HOOKED.w / 4
//!HEIGHT HOOKED.h / 4

vec4 hook() {
    vec2 pos = HOOKED_pos;
    vec2 pt = HOOKED_pt;

    float v_aspect = HOOKED_size.x / HOOKED_size.y;
    float t_aspect = target_size.x / target_size.y;

    if (abs(v_aspect - t_aspect) < 0.01) {
        return HOOKED_tex(pos);
    }

    bool is_letterbox = (v_aspect > t_aspect);

    if (is_letterbox) {
        float h_frac = t_aspect / v_aspect;
        float bar = (1.0 - h_frac) * 0.5;

        bool is_top = (pos.y < bar);
        float edge_y = is_top ? (bar + 0.01) : (1.0 - bar - 0.01);

        // High-density 9-tap bilinear Gaussian blur (covers 17 texels smoothly)
        vec4 sum = vec4(0.0);
        float weights[5] = float[](0.227027, 0.1945946, 0.1216216, 0.054054, 0.016216);
        float offsets[5] = float[](0.0, 1.3846153846, 3.2307692308, 5.0769230769, 6.9230769231);

        sum += HOOKED_tex(vec2(pos.x, edge_y)) * weights[0];
        for (int i = 1; i < 5; i++) {
            float off = offsets[i] * pt.x * 8.0;
            sum += HOOKED_tex(vec2(clamp(pos.x + off, 0.0, 1.0), edge_y)) * weights[i];
            sum += HOOKED_tex(vec2(clamp(pos.x - off, 0.0, 1.0), edge_y)) * weights[i];
        }
        return sum;
    } else {
        float w_frac = v_aspect / t_aspect;
        float bar = (1.0 - w_frac) * 0.5;

        bool is_left = (pos.x < bar);
        float edge_x = is_left ? (bar + 0.01) : (1.0 - bar - 0.01);

        vec4 sum = vec4(0.0);
        float weights[5] = float[](0.227027, 0.1945946, 0.1216216, 0.054054, 0.016216);
        float offsets[5] = float[](0.0, 1.3846153846, 3.2307692308, 5.0769230769, 6.9230769231);

        sum += HOOKED_tex(vec2(edge_x, pos.y)) * weights[0];
        for (int i = 1; i < 5; i++) {
            float off = offsets[i] * pt.y * 8.0;
            sum += HOOKED_tex(vec2(edge_x, clamp(pos.y + off, 0.0, 1.0))) * weights[i];
            sum += HOOKED_tex(vec2(edge_x, clamp(pos.y - off, 0.0, 1.0))) * weights[i];
        }
        return sum;
    }
}

//!HOOK MAIN
//!BIND HOOKED
//!BIND AMBIENT_BLUR1
//!DESC Ambilight Vertical Diffusion & Cinematic Color Composite Pass

vec4 hook() {
    vec2 pos = HOOKED_pos;
    vec2 pt = HOOKED_pt;

    float v_aspect = HOOKED_size.x / HOOKED_size.y;
    float t_aspect = target_size.x / target_size.y;

    if (abs(v_aspect - t_aspect) < 0.01) {
        return HOOKED_tex(pos);
    }

    bool is_letterbox = (v_aspect > t_aspect);

    if (is_letterbox) {
        float h_frac = t_aspect / v_aspect;
        float bar = (1.0 - h_frac) * 0.5;

        // Inside active video region: return pristine untouched video
        if (pos.y >= bar && pos.y <= (1.0 - bar)) {
            float v_y = (pos.y - bar) / h_frac;
            return HOOKED_tex(vec2(pos.x, v_y));
        }

        // Top or bottom bar: vertical 2D blur + color calibration
        bool is_top = (pos.y < bar);
        float dist_from_video = is_top ? (bar - pos.y) / bar : (pos.y - (1.0 - bar)) / bar;

        vec4 sum = vec4(0.0);
        float weights[5] = float[](0.227027, 0.1945946, 0.1216216, 0.054054, 0.016216);
        float offsets[5] = float[](0.0, 1.3846153846, 3.2307692308, 5.0769230769, 6.9230769231);

        sum += AMBIENT_BLUR1_tex(pos) * weights[0];
        for (int i = 1; i < 5; i++) {
            float off = offsets[i] * pt.y * 10.0;
            sum += AMBIENT_BLUR1_tex(vec2(pos.x, clamp(pos.y + off, 0.0, 1.0))) * weights[i];
            sum += AMBIENT_BLUR1_tex(vec2(pos.x, clamp(pos.y - off, 0.0, 1.0))) * weights[i];
        }

        // High-Contrast Cinematic Color Calibration:
        // 1. Natural exponential falloff towards outer monitor bezel
        float falloff = clamp(1.0 - pow(dist_from_video, 1.25), 0.0, 1.0);

        // 2. High contrast & pitch black base (zero milky lift)
        vec3 col = sum.rgb;
        col = clamp((col - 0.06) * 1.65, 0.0, 1.0);
        col = pow(col, vec3(1.3));

        // 3. Vibrant saturation boost (1.8x)
        float luma = dot(col, vec3(0.2126, 0.7152, 0.0722));
        col = clamp(mix(vec3(luma), col, 1.8), 0.0, 1.0);

        // 4. Combine with falloff
        col = col * falloff;

        return vec4(col, 1.0);
    } else {
        float w_frac = v_aspect / t_aspect;
        float bar = (1.0 - w_frac) * 0.5;

        if (pos.x >= bar && pos.x <= (1.0 - bar)) {
            float v_x = (pos.x - bar) / w_frac;
            return HOOKED_tex(vec2(v_x, pos.y));
        }

        bool is_left = (pos.x < bar);
        float dist_from_video = is_left ? (bar - pos.x) / bar : (pos.x - (1.0 - bar)) / bar;

        vec4 sum = vec4(0.0);
        float weights[5] = float[](0.227027, 0.1945946, 0.1216216, 0.054054, 0.016216);
        float offsets[5] = float[](0.0, 1.3846153846, 3.2307692308, 5.0769230769, 6.9230769231);

        sum += AMBIENT_BLUR1_tex(pos) * weights[0];
        for (int i = 1; i < 5; i++) {
            float off = offsets[i] * pt.x * 10.0;
            sum += AMBIENT_BLUR1_tex(vec2(clamp(pos.x + off, 0.0, 1.0), pos.y)) * weights[i];
            sum += AMBIENT_BLUR1_tex(vec2(clamp(pos.x - off, 0.0, 1.0), pos.y)) * weights[i];
        }

        float falloff = clamp(1.0 - pow(dist_from_video, 1.25), 0.0, 1.0);

        vec3 col = sum.rgb;
        col = clamp((col - 0.06) * 1.65, 0.0, 1.0);
        col = pow(col, vec3(1.3));

        float luma = dot(col, vec3(0.2126, 0.7152, 0.0722));
        col = clamp(mix(vec3(luma), col, 1.8), 0.0, 1.0);

        col = col * falloff;

        return vec4(col, 1.0);
    }
}
